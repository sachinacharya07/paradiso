rules_version='2';
service cloud.firestore{match /databases/{db}/documents{
 function admin(){return request.auth!=null&&request.auth.token.email=='your@gmail.com';}
 match /entries/{i}{allow read:if true;allow write:if admin();}
 match /guestbook/{i}{
  allow read:if resource.data.approved==true||admin();
  allow create:if request.resource.data.approved==false&&request.resource.data.msg.size()<=300&&request.resource.data.name.size()<=40;
  allow update,delete:if admin();}
 match /meta/status{allow read:if true;allow write:if admin();}
 match /meta/counter{allow read:if true;allow create:if request.resource.data.n==1;allow update:if request.resource.data.n==resource.data.n+1;}
}}
